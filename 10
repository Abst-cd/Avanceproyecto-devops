import boto3
from botocore.exceptions import ClientError
import os

def upload_file(file_name, bucket, object_name=None):

    if object_name is None:
        object_name = os.path.basename(file_name)

    # Crear el cliente de S3
    s3_client = boto3.client('s3')

    try:
        print(f"Subiendo {file_name} al bucket {bucket}...")
        s3_client.upload_file(file_name, bucket, object_name)
        print("¡Carga exitosa!")
    except ClientError as e:
        print(f"Error de permisos o conexión: {e}")
        return False
    return True


if __name__ == "__main__":
    MI_BUCKET = "solucionestechbucket"
    ARCHIVO = "test.txt"


    with open(ARCHIVO, "w") as f:
        f.write("Archivo generado para el proyecto de Soluciones Tecnológicas.")

    upload_file(ARCHIVO, MI_BUCKET)
